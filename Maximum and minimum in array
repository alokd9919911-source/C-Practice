#include <stdio.h>

int main() {
    int a[5] = {25, 10, 45, 5, 30};
    int max = a[0], min = a[0];

    for(int i = 1; i < 5; i++) {
        if(a[i] > max)
            max = a[i];

        if(a[i] < min)
            min = a[i];
    }

    printf("Maximum = %d\n", max);
    printf("Minimum = %d", min);

    return 0;
}
